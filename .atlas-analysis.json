  "keyFeatures": [
    "dbt-native metrics and dimensions defined in YAML alongside your dbt project",
    "Self-service analytics with drag-and-drop chart builder",
    "SQL Runner for ad-hoc queries directly against your warehouse",
    "Dashboards with filters, tabs, and cross-filtering",
    "Preview BI environments for safe iterative development",
    "Content-as-code (charts and dashboards as YAML) with CLI upload/download",
    "Scheduled deliveries via Slack and Email",
    "Secure embedding with JWT-signed dashboard URLs",
    "CASL-based authorization with custom roles and scopes",
    "Support for BigQuery, Snowflake, Postgres, Redshift, Databricks, DuckDB, Athena, Clickhouse, Trino",
    "Agentic BI features with AI-assisted data exploration",
    "CI/CD integration with automated content validation"
  ],
  "publicApiSurface": [
    "GET/POST /api/v1/projects",
    "GET/POST /api/v1/projects/{projectUuid}/explores",
